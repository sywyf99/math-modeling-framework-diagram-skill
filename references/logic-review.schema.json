{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/math-modeling-framework-diagram/logic-review.schema.json",
  "title": "框架图与论文原文语义审核",
  "type": "object",
  "required": [
    "schema_version",
    "spec_sha256",
    "source_fingerprint",
    "verdict",
    "summary",
    "entity_checks",
    "relation_checks",
    "omissions",
    "fabrications",
    "required_revisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"enum": ["pass", "revise", "unverifiable"]},
    "summary": {"type": "string", "minLength": 1},
    "entity_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "status", "evidence", "notes"],
        "properties": {
          "type": {"enum": ["control", "node", "result"]},
          "id": {"type": "string"},
          "status": {"enum": ["supported", "partial", "unsupported"]},
          "evidence": {"$ref": "#/$defs/evidence"},
          "notes": {"type": "string"}
        }
      }
    },
    "relation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "status", "evidence", "reasoning"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "status": {"enum": ["supported", "uncertain", "contradicted"]},
          "evidence": {"$ref": "#/$defs/evidence"},
          "reasoning": {"type": "string", "minLength": 1}
        }
      }
    },
    "omissions": {"type": "array", "items": {"type": "string"}},
    "fabrications": {"type": "array", "items": {"type": "string"}},
    "required_revisions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "excerpt"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 220}
        }
      }
    }
  }
}
