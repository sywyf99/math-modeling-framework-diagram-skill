{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/math-modeling-framework-diagram/diagram-spec.schema.json",
  "title": "数学建模框架图规格",
  "type": "object",
  "required": ["title", "nodes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "layout": {
      "type": "string",
      "enum": ["pipeline", "comparison", "swimlane", "hub", "hierarchy"]
    },
    "canvas": {
      "type": "string",
      "enum": ["a4-landscape", "16x9"]
    },
    "control": {"$ref": "#/$defs/section"},
    "result": {"$ref": "#/$defs/section"},
    "audit": {"$ref": "#/$defs/audit"},
    "center": {"type": "string"},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 8
        },
        "source_terms": {"$ref": "#/$defs/source_terms"}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["input", "condition", "data", "model", "method", "process", "evaluation", "validation", "result", "conclusion", "default"]
        },
        "items": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 8
        },
        "lane": {"type": "string"},
        "step": {"type": "string"},
        "source_terms": {"$ref": "#/$defs/source_terms"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "label": {"type": "string"},
        "source_terms": {"$ref": "#/$defs/source_terms"}
      }
    },
    "source_terms": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "uniqueItems": true
    },
    "audit": {
      "type": "object",
      "properties": {
        "required_terms": {"$ref": "#/$defs/source_terms"},
        "notes": {"type": "string"}
      }
    }
  }
}
